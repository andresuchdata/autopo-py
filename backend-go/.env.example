# Server Configuration
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=autopo
DB_SSLMODE=disable
# Optional single connection string (overrides the discrete values above when provided)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autopo?sslmode=disable

# Cache configuration
CACHE_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_DASHBOARD_TTL_SECONDS=3600
CACHE_STOCK_HEALTH_TTL_SECONDS=3600

# Application Configuration
APP_UPLOAD_DIR=./data/uploads
APP_DATA_DIR=./data/output
SEED_DATA_DIR=./data/seeds

# Google Drive API Configuration
# Replace with your Google Service Account credentials JSON (single-line string)
GOOGLE_DRIVE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com"}'
STOCK_HEALTH_DRIVE_FOLDER_ID=your-drive-folder-id
STOCK_HEALTH_SNAPSHOT_DATE=

# Seed Data Configuration
RUN_SEED_DATA=true
SEED_FORCE_REFRESH=false

# Cloud Storage Configuration (S3-compatible)
# Enable cloud storage for pipeline raw/intermediate/output data
CLOUD_STORAGE_ENABLED=false
CLOUD_STORAGE_ENDPOINT=https://storage.example.com
CLOUD_STORAGE_BUCKET=pipeline-data
CLOUD_STORAGE_REGION=us-east-1
CLOUD_STORAGE_ACCESS_KEY=your-access-key
CLOUD_STORAGE_SECRET_KEY=your-secret-key
CLOUD_STORAGE_USE_SSL=true
CLOUD_STORAGE_PREFIX=

# Ingestion Test Configuration (Local)
STOCK_HEALTH_REUSE_LOCAL=true
STOCK_HEALTH_DOWNLOAD_DIR=./data/test_ingestion
STOCK_HEALTH_PERSIST_DEBUG_LAYERS=true
